menuconfig ZMK_KEY_TELEMETRY
    bool "ZMK key-position telemetry over Bluetooth LE"
    default n
    depends on ZMK_BLE
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Expose encrypted, read/notify BLE GATT telemetry containing physical
      position state and the complete active-layer mask. This listener never
      consumes or modifies ZMK events. On a split keyboard it must be enabled
      only on the central half.

if ZMK_KEY_TELEMETRY

config ZMK_KEY_TELEMETRY_QUEUE_SIZE
    int "Pending telemetry notification records"
    default 8
    range 2 32
    help
      Maximum number of 20-byte records waiting for BLE transmission.
      Overflow discards the oldest record; the sequence gap tells the client
      that this happened and every later record contains authoritative state.

endif # ZMK_KEY_TELEMETRY
